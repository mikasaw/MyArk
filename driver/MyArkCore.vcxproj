    </ClCompile>
    <Link>
      <!-- cng.lib: kernel-mode CNG (HMAC-SHA256 for the safety-token
           validator; binds the import to cng.sys. The WDK km dir has no
           bcrypt.lib, so linking the um one imports bcrypt.dll and the
           driver fails to load with STATUS_OBJECT_NAME_NOT_FOUND).
           ntoskrnl.lib: SystemPrng for the session key.
           fltmgr.lib: minifilter registration (filemon module, R2-7). -->
      <AdditionalDependencies>cng.lib;ntoskrnl.lib;fltmgr.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <AdditionalOptions>/GUARD:NO /INTEGRITYCHECK %(AdditionalOptions)</AdditionalOptions>
    </Link>
